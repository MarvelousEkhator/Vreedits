// app/api/settings/app/route.js
import { NextResponse } from "next/server";
import { prisma } from "@/lib/prisma";
import { requireUser } from "@/lib/requireUser";
import {
  ageFromDob, tierForAge, getSettings, publicSettings, sanitizePatch,
  touchesGuarded, protectionFixes, mergeNotifPrefs,
} from "@/lib/userSettings";

const USER_SELECT = {
  id: true, username: true, displayName: true, avatarDataUrl: true, email: true,
  verified: true, createdAt: true, country: true, language: true, dateOfBirth: true,
  isGuest: true, isPublic: true, allowDownloads: true, allowComments: true,
  allowMentions: true, shareProfileLinks: true, hideFollowing: true, hideLikedVideos: true,
};
const LITE_AUTHOR_SELECT = { id: true, username: true, displayName: true, avatarDataUrl: true };

// Builds the full settings picture, and quietly applies the age protections
// (so a under-16 account is really private everywhere in the app, not just
// on this page).
async function buildPayload(userId) {
  let user = await prisma.user.findUnique({ where: { id: userId }, select: USER_SELECT });
  if (!user) return null;
  let settings = await getSettings(userId);

  const age = ageFromDob(user.dateOfBirth);
  const tier = tierForAge(age);

  const fixes = protectionFixes(tier, user, settings);
  if (Object.keys(fixes.userData).length) {
    user = await prisma.user.update({ where: { id: userId }, data: fixes.userData, select: USER_SELECT });
  }
  if (Object.keys(fixes.settingsData).length) {
    settings = await prisma.userSettings.update({ where: { userId }, data: fixes.settingsData });
  }

  return {
    user: { ...user, dateOfBirth: user.dateOfBirth ? user.dateOfBirth.toISOString().slice(0, 10) : null },
    settings: publicSettings(settings),
    age,
    tier,
    hasPin: !!settings.guardianPinHash,
  };
}

export async function GET(req) {
  const user = await requireUser();
  if (!user) return NextResponse.json({ error: "Not authenticated." }, { status: 401 });

  const { searchParams } = new URL(req.url);

  // Creators this person has muted.
  if (searchParams.get("list") === "muted") {
    const rows = await prisma.mutedCreator.findMany({
      where: { userId: user.id },
      orderBy: { createdAt: "desc" },
      take: 200,
      select: { mutedUserId: true },
    });
    const ids = rows.map((r) => r.mutedUserId);
    const users = ids.length
      ? await prisma.user.findMany({ where: { id: { in: ids } }, select: LITE_AUTHOR_SELECT })
      : [];
    return NextResponse.json({ muted: users });
  }

  const payload = await buildPayload(user.id);
  if (!payload) return NextResponse.json({ error: "Account not found." }, { status: 404 });
  return NextResponse.json(payload);
}

export async function PATCH(req) {
  const user = await requireUser();
  if (!user) return NextResponse.json({ error: "Not authenticated." }, { status: 401 });

  let body;
  try {
    body = await req.json();
  } catch {
    return NextResponse.json({ error: "Invalid request." }, { status: 400 });
  }

  const [settings, full] = await Promise.all([
    getSettings(user.id),
    prisma.user.findUnique({ where: { id: user.id }, select: { dateOfBirth: true } }),
  ]);

  let tier = tierForAge(ageFromDob(full?.dateOfBirth));

  // A birthday can be added once, and never changed after that.
  let dobData = null;
  if (typeof body.dateOfBirth === "string") {
    if (full?.dateOfBirth) {
      return NextResponse.json({ error: "Your birthday can't be changed. Contact support if it's wrong." }, { status: 403 });
    }
    if (!/^\d{4}-\d{2}-\d{2}$/.test(body.dateOfBirth)) {
      return NextResponse.json({ error: "Enter a valid birthday." }, { status: 400 });
    }
    const d = new Date(`${body.dateOfBirth}T00:00:00Z`);
    const newAge = ageFromDob(d);
    if (isNaN(d.getTime()) || newAge === null || newAge > 120 || d > new Date()) {
      return NextResponse.json({ error: "Enter a valid birthday." }, { status: 400 });
    }
    if (newAge < 13) {
      return NextResponse.json({ error: "You must be at least 13 to use Vreedits." }, { status: 400 });
    }
    dobData = d;
    tier = tierForAge(newAge);
  }

  const { userData, settingsData, notifPatch, error } = sanitizePatch(body, tier);
  if (error) return NextResponse.json({ error, locked: true }, { status: 403 });

  // With a guardian PIN set, safety and screen-time settings only change
  // through the parental controls screen.
  if (settings.guardianPinHash && touchesGuarded(userData, settingsData)) {
    return NextResponse.json(
      { error: "These settings are locked by parental controls.", locked: true },
      { status: 403 }
    );
  }

  if (dobData) userData.dateOfBirth = dobData;
  if (notifPatch) {
    settingsData.notifPrefs = { ...mergeNotifPrefs(settings.notifPrefs), ...notifPatch };
  }

  const ops = [];
  if (Object.keys(userData).length) {
    ops.push(prisma.user.update({ where: { id: user.id }, data: userData }));
  }
  if (Object.keys(settingsData).length) {
    ops.push(prisma.userSettings.update({ where: { userId: user.id }, data: settingsData }));
  }
  if (ops.length) await prisma.$transaction(ops);

  const payload = await buildPayload(user.id);
  return NextResponse.json(payload);
}
