generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  username String @unique
  displayName String?
  email    String @unique
  passwordHash String
  verified     Boolean @default(false)
  online       Boolean @default(false)
  lastSeenAt   DateTime?
  avatarDataUrl String?  @db.Text
  bio           String?  @db.Text
  allowDownloads Boolean @default(true)
  country       String?
  language      String   @default("English")
  isPublic      Boolean  @default(true)
  verificationCode    String?
  verificationExpires DateTime?
  resetCode    String?
  resetExpires DateTime?
  lastCodeSentAt DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  conversations Conversation[]
  toolRuns      ToolRun[]
  collections   Collection[]
  ownedCommunities Community[]
  posts            Post[]
  comments         Comment[]
  notifications    Notification[]
  hostedEvents     Event[]
  modActions       ModerationAction[] @relation("ModActionModerator")
  flashcardDecks FlashcardDeck[]
  notes          Note[]
  folders        Folder[]
  studySessions  StudySession[]
  feedPosts      FeedPost[]
  feedComments   FeedComment[]
  feedSaves      FeedSave[]
  followers Follow[] @relation("Followers")
  following Follow[] @relation("Following")
  hostedStudyRooms     StudyRoom[]        @relation("StudyRoomHost")
  studyRoomMemberships StudyRoomMember[]  @relation("StudyRoomMemberships")
  studyRoomMessages    StudyRoomMessage[] @relation("StudyRoomMessages")
  tutorConversations   TutorConversation[]
  clients              Client[]
  projects             Project[]
  ownedBusinesses      Business[]   @relation("BusinessOwner")
  teamMemberships      TeamMember[]
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Conversation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String
  messages Json
  pinned Boolean @default(false)
  shareToken String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ToolRun {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolId       String
  toolLabel    String
  inputSummary String
  result       String  @db.Text
  favorited    Boolean @default(false)
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Collection {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  createdAt DateTime  @default(now())
  toolRuns  ToolRun[]
}

model Community {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String? @unique
  description String? @db.Text
  iconDataUrl String? @db.Text
  bannerDataUrl String? @db.Text
  category    String?
  tags        String[] @default([])
  accentColor String?
  joinMode      String  @default("anyone")
  discoverable  Boolean @default(true)
  welcomeMessage    String? @db.Text
  defaultChannelId  String?
  rulesAcknowledgedBy String[] @default([])
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  memberIds String[] @default([])
  adminIds  String[] @default([])
  createdAt DateTime @default(now())
  posts     Post[]
  channels  Channel[]
  sections  Section[]
  roles     Role[]
  events    Event[]
  rules     Rule[]
  invites   Invite[]
  reports   Report[]
  modActions ModerationAction[]
  applications JoinApplication[]
}

model Section {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name  String
  order Int    @default(0)
  createdAt DateTime @default(now())
  channels  Channel[]
}

model Channel {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  name  String
  type  String @default("text")
  order Int    @default(0)
  archived Boolean @default(false)
  visibility      String   @default("public")
  allowedRoleIds  String[] @default([])
  canSendMessages Boolean  @default(true)
  canSendImages   Boolean  @default(true)
  canUseThreads   Boolean  @default(true)
  emojiMode       String   @default("all")
  allowedEmojis   String[] @default([])
  viewAccess    Json?
  sendAccess    Json?
  threadAccess  Json?
  manageAccess  Json?
  createdAt DateTime @default(now())
  posts     Post[]
}

model Role {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  position    Int      @default(0)
  permissions String[] @default([])
  memberIds   String[] @default([])
  createdAt DateTime @default(now())
}

model Rule {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  text  String @db.Text
  order Int    @default(0)
  createdAt DateTime @default(now())
}

model Invite {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  code       String   @unique
  maxUses    Int?
  useCount   Int      @default(0)
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
}

model Report {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  reporterId  String
  targetType  String
  targetId    String
  reason      String   @db.Text
  status      String   @default("open")
  createdAt   DateTime @default(now())
}

model ModerationAction {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  moderatorId String
  moderator   User   @relation("ModActionModerator", fields: [moderatorId], references: [id], onDelete: Cascade)
  targetUserId String
  action      String
  reason      String?  @db.Text
  createdAt   DateTime @default(now())
}

model JoinApplication {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  applicantId String
  answers     Json?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model Event {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  startTime   DateTime
  hostId String
  host   User   @relation(fields: [hostId], references: [id], onDelete: Cascade)
  attendeeIds String[] @default([])
  createdAt DateTime @default(now())
}

model Post {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title          String?  @db.Text
  content        String   @db.Text
  imageUrl       String?  @db.Text
  likedBy        String[] @default([])
  isAnnouncement Boolean  @default(false)
  pinned         Boolean  @default(false)
  replyToId      String?
  createdAt DateTime  @default(now())
  comments  Comment[]
}

model Comment {
  id     String @id @default(uuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content String @db.Text
  createdAt DateTime @default(now())
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  title       String
  description String
  read        Boolean @default(false)
  createdAt DateTime @default(now())
}

model FlashcardDeck {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  subject    String?
  sourceText String? @db.Text
  coverImageUrl        String? @db.Text
  coverImageCreditName String?
  coverImageCreditUrl  String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cards     Flashcard[]
}

model Flashcard {
  id     String        @id @default(uuid())
  deckId String
  deck   FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front  String @db.Text
  back   String @db.Text
  status String @default("new")
  imageUrl        String? @db.Text
  imageCreditName String?
  imageCreditUrl  String? @db.Text
  createdAt DateTime @default(now())
}

model Note {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  coverImageUrl String?  @db.Text
  subject       String?
  tags          String[] @default([])
  content       Json     @default("[]")
  pinned        Boolean  @default(false)
  folderId      String?
  folder        Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  isAssignment  Boolean  @default(false)
  dueDate       DateTime?
  submitted     Boolean  @default(false)
  shareToken    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Folder {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  createdAt DateTime @default(now())
  notes     Note[]
}

model StudySession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject String
  minutes Int
  note    String?
  createdAt DateTime @default(now())
}

model FeedPost {
  id       String @id @default(uuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  caption   String? @db.Text
  mediaUrl  String? @db.Text
  mediaType String  @default("image")
  isPrivate Boolean @default(false)
  likedBy   String[] @default([])
  createdAt DateTime @default(now())
  comments  FeedComment[]
  saves     FeedSave[]
}

model FeedComment {
  id     String   @id @default(uuid())
  postId String
  post   FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content String @db.Text
  createdAt DateTime @default(now())
}

model FeedSave {
  id     String   @id @default(uuid())
  postId String
  post   FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model StudyRoom {
  id     String @id @default(uuid())
  hostId String
  host   User   @relation("StudyRoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  name    String
  subject String?
  status  String @default("active") // "active" | "ended"
  timerStartedAt       DateTime?
  timerDurationMinutes Int?
  createdAt DateTime @default(now())
  members  StudyRoomMember[]
  messages StudyRoomMessage[]
}

model StudyRoomMember {
  id     String    @id @default(uuid())
  roomId String
  room   StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation("StudyRoomMemberships", fields: [userId], references: [id], onDelete: Cascade)
  status       String   @default("invited") // "invited" | "studying" | "break" | "left"
  joinedAt     DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@unique([roomId, userId])
}

model StudyRoomMessage {
  id     String    @id @default(uuid())
  roomId String
  room   StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation("StudyRoomMessages", fields: [userId], references: [id], onDelete: Cascade)
  text   String @db.Text
  createdAt DateTime @default(now())
}

model TutorConversation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String
  messages Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  company String?
  email   String?
  phone   String?
  createdAt DateTime @default(now())
  notes     Note[]
}

model Project {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String? @db.Text
  status      String  @default("active") // "active" | "completed" | "archived"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks       ProjectTask[]
}

model ProjectTask {
  id     String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  status    String  @default("todo") // "todo" | "in_progress" | "done"
  dueDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Business {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("BusinessOwner", fields: [ownerId], references: [id])
  members   TeamMember[]
  invoices  Invoice[]
  invites   TeamInvite[]
  createdAt DateTime @default(now())
}

model TeamMember {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  role       String   @default("member") // "owner" | "admin" | "member"
  joinedAt   DateTime @default(now())

  @@unique([businessId, userId])
}

model TeamInvite {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  email      String
  role       String   @default("member")
  token      String   @unique
  status     String   @default("pending") // "pending" | "accepted" | "revoked"
  createdAt  DateTime @default(now())
}

model Invoice {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  clientName  String
  items       Json      // [{ description, quantity, unitPrice }]
  status      String    @default("draft") // "draft" | "sent" | "paid" | "overdue"
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
}