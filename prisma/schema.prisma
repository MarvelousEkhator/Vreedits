generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  username String @unique
  displayName String?
  email    String @unique
  passwordHash String
  verified     Boolean @default(false)
  online       Boolean @default(false)
  lastSeenAt   DateTime?
  avatarDataUrl String?  @db.Text
  bio           String?  @db.Text
  allowDownloads Boolean @default(true)
  country       String?
  school        String?
  language      String   @default("English")
  isPublic      Boolean  @default(true)
  isGuest       Boolean  @default(false)
  verificationCode    String?
  verificationExpires DateTime?
  resetCode    String?
  resetExpires DateTime?
  lastCodeSentAt DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  dateOfBirth     DateTime?
  termsAcceptedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  conversations Conversation[]
  toolRuns      ToolRun[]
  collections   Collection[]
  ownedCommunities Community[]
  posts            Post[]
  comments         Comment[]
  notifications    Notification[]
  hostedEvents     Event[]
  modActions       ModerationAction[] @relation("ModActionModerator")
  flashcardDecks FlashcardDeck[]
  notes          Note[]
  folders        Folder[]
  studySessions  StudySession[]
  feedPosts      FeedPost[]
  feedComments   FeedComment[]
  feedSaves      FeedSave[]
  followers Follow[] @relation("Followers")
  following Follow[] @relation("Following")
  hostedStudyRooms     StudyRoom[]        @relation("StudyRoomHost")
  studyRoomMemberships StudyRoomMember[]  @relation("StudyRoomMemberships")
  studyRoomMessages    StudyRoomMessage[] @relation("StudyRoomMessages")
  tutorConversations   TutorConversation[]
  clients              Client[]
  projects             Project[]
  ownedBusinesses      Business[]   @relation("BusinessOwner")
  teamMemberships      TeamMember[]
  hostedCodeRooms      CodeRoom[]   @relation("CodeRoomHost")
  stories              Story[]
  pollVotes            PollVote[]

  // Future chat system (Message-based) — not yet in use
  messages         Message[]
  messageReactions MessageReaction[]
  threadMessages   ThreadMessage[]
  joinEvents       JoinEvent[]

  // ACTIVE — reactions on the current Post-based chat
  postReactions PostReaction[]

  // ACTIVE — friends & DMs
  friendRequestsSent     FriendRequest[] @relation("FriendRequestsSent")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestsReceived")
  friendshipsAsA         Friendship[]    @relation("FriendshipUserA")
  friendshipsAsB         Friendship[]    @relation("FriendshipUserB")
  directMessagesSent     DirectMessage[] @relation("DirectMessagesSent")
  directMessagesReceived DirectMessage[] @relation("DirectMessagesReceived")

  // ACTIVE — Community onboarding
  onboardingCompletions OnboardingCompletion[]
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Conversation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String
  messages Json
  pinned Boolean @default(false)
  shareToken String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ToolRun {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolId       String
  toolLabel    String
  inputSummary String
  result       String  @db.Text
  favorited    Boolean @default(false)
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Collection {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  createdAt DateTime  @default(now())
  toolRuns  ToolRun[]
}

model Community {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String? @unique
  description String? @db.Text
  iconDataUrl String? @db.Text
  bannerDataUrl String? @db.Text
  category    String?
  tags        String[] @default([])
  accentColor String?
  joinMode      String  @default("anyone")
  discoverable  Boolean @default(true)
  welcomeMessage    String? @db.Text
  defaultChannelId  String?
  rulesAcknowledgedBy String[] @default([])
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  memberIds String[] @default([])
  adminIds  String[] @default([])
  createdAt DateTime @default(now())
  posts     Post[]
  channels  Channel[]
  sections  Section[]
  roles     Role[]
  events    Event[]
  rules     Rule[]
  invites   Invite[]
  reports   Report[]
  modActions ModerationAction[]
  applications JoinApplication[]

  verificationLevel    String    @default("none")
  raidProtectionOn     Boolean   @default(true)
  maxMentionsPerMsg    Int       @default(5)
  captchaRequiredUntil DateTime?
  joinLockdown         Boolean   @default(false)
  joinEvents           JoinEvent[]
  guide       CommunityGuide?
  // ACTIVE — Community onboarding
  onboarding  CommunityOnboarding?
  onboardingCompletions OnboardingCompletion[]
  emojis      CommunityEmoji[]
  bans        CommunityBan[]
  restrictions MemberRestriction[]
}

model Section {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name  String
  order Int    @default(0)
  createdAt DateTime @default(now())
  channels  Channel[]
}

model Channel {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  name  String
  type  String @default("text")
  order Int    @default(0)
  archived Boolean @default(false)
  visibility      String   @default("public")
  allowedRoleIds  String[] @default([])
  canSendMessages Boolean  @default(true)
  canSendImages   Boolean  @default(true)
  canUseThreads   Boolean  @default(true)
  emojiMode       String   @default("all")
  allowedEmojis   String[] @default([])
  viewAccess    Json?
  sendAccess    Json?
  threadAccess  Json?
  manageAccess  Json?
  createdAt DateTime @default(now())
  posts     Post[]

  messages  Message[]
  threads   Thread[]
}

model Role {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  position    Int      @default(0)
  permissions String[] @default([])
  memberIds   String[] @default([])
  createdAt DateTime @default(now())
}

model Rule {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  text  String @db.Text
  order Int    @default(0)
  createdAt DateTime @default(now())
}

model Invite {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  code       String   @unique
  maxUses    Int?
  useCount   Int      @default(0)
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
}

model Report {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  reporterId  String
  targetType  String
  targetId    String
  reason      String   @db.Text
  status      String   @default("open")
  createdAt   DateTime @default(now())
}

model ModerationAction {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  moderatorId String
  moderator   User   @relation("ModActionModerator", fields: [moderatorId], references: [id], onDelete: Cascade)
  targetUserId String
  action      String
  reason      String?  @db.Text
  createdAt   DateTime @default(now())
}

model JoinApplication {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  applicantId String
  answers     Json?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model Event {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  startTime   DateTime
  hostId String
  host   User   @relation(fields: [hostId], references: [id], onDelete: Cascade)
  attendeeIds String[] @default([])
  createdAt DateTime @default(now())
}

model Post {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title          String?  @db.Text
  content        String   @db.Text
  imageUrl       String?  @db.Text
  likedBy        String[] @default([])
  isAnnouncement Boolean  @default(false)
  pinned         Boolean  @default(false)
  replyToId      String?
  createdAt DateTime  @default(now())
  comments  Comment[]

  reactions PostReaction[]
}

model PostReaction {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([postId, userId, emoji])
}

model Comment {
  id     String @id @default(uuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content String @db.Text
  createdAt DateTime @default(now())
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  title       String
  description String
  read        Boolean @default(false)
  createdAt DateTime @default(now())
}

model FlashcardDeck {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  subject    String?
  sourceText String? @db.Text
  coverImageUrl        String? @db.Text
  coverImageCreditName String?
  coverImageCreditUrl  String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cards     Flashcard[]
}

model Flashcard {
  id     String        @id @default(uuid())
  deckId String
  deck   FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front  String @db.Text
  back   String @db.Text
  status String @default("new")
  imageUrl        String? @db.Text
  imageCreditName String?
  imageCreditUrl  String? @db.Text
  createdAt DateTime @default(now())
}

model Note {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  coverImageUrl String?  @db.Text
  subject       String?
  tags          String[] @default([])
  content       Json     @default("[]")
  pinned        Boolean  @default(false)
  folderId      String?
  folder        Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  isAssignment  Boolean  @default(false)
  dueDate       DateTime?
  submitted     Boolean  @default(false)
  shareToken    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Folder {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  createdAt DateTime @default(now())
  notes     Note[]
}

model StudySession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject String
  minutes Int
  note    String?
  createdAt DateTime @default(now())
}

model FeedPost {
  id       String @id @default(uuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  caption   String? @db.Text
  mediaUrl  String? @db.Text
  mediaUrls String[] @default([])
  mediaType String  @default("image")
  isPrivate Boolean @default(false)
  isDraft   Boolean @default(false)
  scheduledFor DateTime?
  likedBy   String[] @default([])
  tags      String[] @default([])
  createdAt DateTime @default(now())
  comments  FeedComment[]
  saves     FeedSave[]
  poll      FeedPoll?
}

model FeedComment {
  id     String   @id @default(uuid())
  postId String
  post   FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content String @db.Text
  likedBy   String[] @default([])
  pinned    Boolean  @default(false)
  parentId  String?
  parent    FeedComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   FeedComment[] @relation("CommentReplies")
  createdAt DateTime @default(now())
}

model FeedSave {
  id     String   @id @default(uuid())
  postId String
  post   FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model FeedPoll {
  id        String     @id @default(uuid())
  postId    String     @unique
  post      FeedPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  question  String     @db.Text
  options   Json       // [{ id, label }]
  votes     PollVote[]
  createdAt DateTime   @default(now())
}

model PollVote {
  id        String   @id @default(uuid())
  pollId    String
  poll      FeedPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionId  String
  createdAt DateTime @default(now())

  @@unique([pollId, userId])
}

model StudyRoom {
  id     String @id @default(uuid())
  hostId String
  host   User   @relation("StudyRoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  name    String
  subject String?
  status  String @default("active")
  timerStartedAt       DateTime?
  timerDurationMinutes Int?
  createdAt DateTime @default(now())
  members  StudyRoomMember[]
  messages StudyRoomMessage[]
}

model StudyRoomMember {
  id     String    @id @default(uuid())
  roomId String
  room   StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation("StudyRoomMemberships", fields: [userId], references: [id], onDelete: Cascade)
  status       String   @default("invited")
  joinedAt     DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@unique([roomId, userId])
}

model StudyRoomMessage {
  id     String    @id @default(uuid())
  roomId String
  room   StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation("StudyRoomMessages", fields: [userId], references: [id], onDelete: Cascade)
  text   String @db.Text
  createdAt DateTime @default(now())
}

model TutorConversation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String
  messages Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  name    String
  company String?
  email   String?
  phone   String?
  createdAt DateTime @default(now())
  notes     Note[]
}

model Project {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  name        String
  description String? @db.Text
  status      String  @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks       ProjectTask[]
  codeRooms   CodeRoom[]
}

model ProjectTask {
  id     String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  status    String  @default("todo")
  dueDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Business {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("BusinessOwner", fields: [ownerId], references: [id])
  members   TeamMember[]
  invoices  Invoice[]
  invites   TeamInvite[]
  projects  Project[]
  clients   Client[]
  codeRooms CodeRoom[]
  createdAt DateTime @default(now())
}

model TeamMember {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  role       String   @default("member")
  joinedAt   DateTime @default(now())

  @@unique([businessId, userId])
}

model TeamInvite {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  email      String
  role       String   @default("member")
  token      String   @unique
  status     String   @default("pending")
  createdAt  DateTime @default(now())
}

model Invoice {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  clientName  String
  items       Json
  status      String    @default("draft")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
}

model CodeRoom {
  id         String    @id @default(uuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  hostId     String
  host       User      @relation("CodeRoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  name       String
  language   String    @default("javascript")
  code       String    @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ─────────────────────────────────────────────
// FUTURE CHAT SYSTEM (Message-based) — not wired up yet, for later migration
// ─────────────────────────────────────────────

model Message {
  id          String    @id @default(uuid())
  channelId   String
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content     String?   @db.Text
  attachments Json?

  replyToId   String?
  replyTo     Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[] @relation("MessageReplies")

  threadId    String?   @unique
  thread      Thread?

  forwardedFromId String?
  forwardedFrom   Message? @relation("MessageForwards", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards        Message[] @relation("MessageForwards")

  mentionsUserIds  String[] @default([])
  mentionsEveryone Boolean  @default(false)

  pinned      Boolean   @default(false)
  edited      Boolean   @default(false)
  editedAt    DateTime?
  deletedAt   DateTime?

  createdAt   DateTime  @default(now())

  reactions   MessageReaction[]

  @@index([channelId, createdAt])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

model Thread {
  id              String    @id @default(uuid())
  parentMessageId String    @unique
  parentMessage   Message   @relation(fields: [parentMessageId], references: [id], onDelete: Cascade)
  channelId       String
  channel         Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name            String
  visibility      String    @default("public")
  archived        Boolean   @default(false)
  archivedAt      DateTime?
  autoArchiveMinutes Int    @default(1440)
  createdAt       DateTime  @default(now())
  messages        ThreadMessage[]
  memberIds       String[]  @default([])
}

model ThreadMessage {
  id          String   @id @default(uuid())
  threadId    String
  thread      Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String?  @db.Text
  attachments Json?
  edited      Boolean  @default(false)
  editedAt    DateTime?
  createdAt   DateTime @default(now())
  reactions   ThreadMessageReaction[]
}

model ThreadMessageReaction {
  id              String        @id @default(uuid())
  threadMessageId String
  threadMessage   ThreadMessage @relation(fields: [threadMessageId], references: [id], onDelete: Cascade)
  userId          String
  emoji           String
  createdAt       DateTime      @default(now())

  @@unique([threadMessageId, userId, emoji])
}

model JoinEvent {
  id             String    @id @default(uuid())
  communityId    String
  community      Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountAgeDays Int
  hasAvatar      Boolean   @default(false)
  riskScore      Int       @default(0)
  flagged        Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([communityId, createdAt])
}

// ─────────────────────────────────────────────
// ACTIVE — friends & direct messages
// ─────────────────────────────────────────────

model FriendRequest {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("FriendRequestsSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("FriendRequestsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([senderId, receiverId])
}

model Friendship {
  id         String   @id @default(uuid())
  userAId    String
  userA      User     @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId    String
  userB      User     @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userAId, userBId])
}

model DirectMessage {
  id         String    @id @default(uuid())
  senderId   String
  sender     User      @relation("DirectMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User      @relation("DirectMessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String?   @db.Text
  attachments Json?
  read       Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
}

model SuspiciousAiAttempt {
  id        String   @id @default(cuid())
  actorId   String
  isGuest   Boolean  @default(false)
  reason    String
  message   String
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}

// ─────────────────────────────────────────────
// ACTIVE — Community Onboarding (Advanced Community Features, Feature 1)
// ─────────────────────────────────────────────

model CommunityOnboarding {
  id          String    @id @default(uuid())
  communityId String    @unique
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  enabled     Boolean  @default(false)
  welcomeTitle String?
  welcomeBody  String?  @db.Text

  // [{ id, text, type: "single" | "multi" | "text", options: [{ id, label, roleId }] }]
  questions   Json     @default("[]")

  recommendedChannelIds String[] @default([])
  requireRulesAck        Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completions OnboardingCompletion[]
}

model OnboardingCompletion {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  onboardingId String
  onboarding   CommunityOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  // { [questionId]: optionId | optionId[] | string }
  answers   Json     @default("{}")
  createdAt DateTime @default(now())

  @@unique([communityId, userId])
}

model Story {
  id         String   @id @default(uuid())
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mediaUrl   String   @db.Text
  mediaType  String   @default("image") // "image" or "video"
  caption    String?  @db.Text
  viewedBy   String[] @default([])
  createdAt  DateTime @default(now())

  @@index([authorId, createdAt])
}

model CommunityGuide {
  id          String    @id @default(uuid())
  communityId String    @unique
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  introduction  String? @db.Text
  importantInfo String? @db.Text

  recommendedChannelIds String[] @default([])

  // [{ id, question, answer }]
  faqs      Json @default("[]")
  // [{ id, label, url }]
  resources Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// ACTIVE — Community admin tools (Audit Log, AutoMod, Emojis, Webhooks, Integrations, Widget)
// ─────────────────────────────────────────────

model AuditLogEntry {
  id          String   @id @default(uuid())
  communityId String
  actorId     String
  action      String
  targetType  String?
  targetId    String?
  summary     String   @db.Text
  createdAt   DateTime @default(now())

  @@index([communityId, createdAt])
}

model AutoModRule {
  id          String   @id @default(uuid())
  communityId String
  name        String
  type        String
  config      Json     @default("{}")
  action      String   @default("block")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([communityId])
}

model CommunityEmoji {
  id           String    @id @default(uuid())
  communityId  String
  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name         String
  imageDataUrl String    @db.Text
  type         String    @default("emoji") // "emoji" | "sticker"
  createdById  String?
  createdAt    DateTime  @default(now())

  @@unique([communityId, name])
}

model CommunityWebhook {
  id          String   @id @default(uuid())
  communityId String
  channelId   String
  name        String
  token       String   @unique
  createdById String
  createdAt   DateTime @default(now())

  @@index([communityId])
}

model CommunityIntegration {
  id          String   @id @default(uuid())
  communityId String
  provider    String
  label       String
  url         String   @db.Text
  channelId   String?
  enabled     Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  @@index([communityId])
}

model CommunityWidget {
  id          String   @id @default(uuid())
  communityId String   @unique
  enabled     Boolean  @default(false)
  theme       String   @default("dark")
  showMembers Boolean  @default(true)
  inviteCode  String?
  updatedAt   DateTime @updatedAt
}

model CommunityBan {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  username    String
  reason      String?   @db.Text
  bannedById  String
  createdAt   DateTime  @default(now())

  @@unique([communityId, userId])
}

model MemberRestriction {
  id             String    @id @default(uuid())
  communityId    String
  community      Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId         String
  username       String
  reason         String?   @db.Text
  expiresAt      DateTime
  restrictedById String
  createdAt      DateTime  @default(now())

  @@unique([communityId, userId])
}
